{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:monorepos",
    "group:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"],
    "automerge": true
  },
  "enabledManagers": [
    "npm",
    "gomod",
    "devbox",
    "dockerfile",
    "docker-compose",
    "devcontainer",
    "github-actions",
    "custom.regex"
  ],
  "postUpdateOptions": ["gomodTidy", "pnpmDedupe"],
  "devbox": {
    "managerFilePatterns": ["/(^|/)devbox\\.jsonc?$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Go version in go.work (go.mod `go` directives are handled by the gomod manager)",
      "managerFilePatterns": ["/(^|/)go\\.work$/"],
      "matchStrings": ["^go (?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\\s*$"],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "golangci-lint version pinned in the CI workflow",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s",
        "golangci-lint/v2/cmd/golangci-lint@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "pnpm version pinned in the Dockerfile (keep in sync with devbox.jsonc)",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG PNPM_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "sqlc version pinned in the CI workflow (keep in sync with devbox.jsonc)",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["sqlc-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"],
      "depNameTemplate": "sqlc",
      "packageNameTemplate": "sqlc-dev/sqlc",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Devcontainer image tag baked into the nix volume names in compose.yaml (the image line itself is handled by docker-compose)",
      "managerFilePatterns": ["/(^|/)\\.devcontainer/compose\\.ya?ml$/"],
      "matchStrings": ["shared-nix-my-devcontainer-(?<currentValue>\\d{4}\\.\\d{2}\\.\\d{2})"],
      "depNameTemplate": "ghcr.io/hilmoo/containers/my-devcontainer",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "protoforge release pinned in post-create.sh",
      "managerFilePatterns": ["/(^|/)\\.devcontainer/post-create\\.sh$/"],
      "matchStrings": ["PROTOFORGE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s"],
      "depNameTemplate": "hilmoo/protoforge",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "devbox version referenced by the devbox.jsonc $schema URL",
      "managerFilePatterns": ["/(^|/)devbox\\.jsonc?$/"],
      "matchStrings": ["jetify-com/devbox/(?<currentValue>\\d+\\.\\d+\\.\\d+)/"],
      "depNameTemplate": "jetify-com/devbox",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates (minor/patch automerge via the rule below)",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "pinDigests": false
    },
    {
      "description": "Automerge low-risk updates (minor/patch/digest) once checks pass",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true
    },
    {
      "description": "Group all non-major JS dependencies",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "js dependencies (non-major)"
    },
    {
      "description": "Group all non-major Go modules",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go modules (non-major)"
    },
    {
      "description": "Group non-major devbox (nix) tool updates",
      "matchManagers": ["devbox"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "devbox tools (non-major)"
    },
    {
      "description": "Group container images used in devcontainer / compose",
      "matchManagers": ["docker-compose", "devcontainer"],
      "groupName": "dev containers",
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "Keep linters / formatters in one PR",
      "matchPackageNames": [
        "oxlint",
        "oxfmt",
        "tsgolint",
        "golangci-lint",
        "golangci/golangci-lint"
      ],
      "groupName": "lint & format tooling"
    },
    {
      "description": "Keep protobuf / connect / buf codegen tools and runtimes together",
      "matchPackageNames": [
        "protobuf",
        "buf",
        "/^buf/",
        "/^protoc-/",
        "/^@bufbuild\\//",
        "/^@connectrpc\\//",
        "/^connectrpc\\.com\\//",
        "/^google\\.golang\\.org\\/(protobuf|grpc)/"
      ],
      "groupName": "protobuf & connect"
    },
    {
      "description": "Keep OpenAPI / TypeSpec / orval tooling together",
      "matchPackageNames": ["/^@typespec\\//", "/^orval/", "/^openapi-/"],
      "groupName": "openapi tooling"
    },
    {
      "description": "Keep drizzle packages together",
      "matchPackageNames": ["/^drizzle-/"],
      "groupName": "drizzle"
    },
    {
      "description": "Dev container image + its nix volume names must change together",
      "matchPackageNames": ["ghcr.io/hilmoo/containers/my-devcontainer"],
      "groupName": "dev containers",
      "automerge": false
    },
    {
      "description": "sqlc is pinned in devbox.jsonc and the CI workflow: one PR",
      "matchPackageNames": ["sqlc", "sqlc-dev/sqlc"],
      "groupName": "sqlc"
    },
    {
      "description": "Keep TanStack packages together (several are pinned exactly)",
      "matchPackageNames": ["/^@tanstack\\//"],
      "groupName": "tanstack"
    },
    {
      "description": "Keep Mantine packages together",
      "matchPackageNames": ["/^@mantine\\//"],
      "groupName": "mantine"
    },
    {
      "description": "Keep React and its types together",
      "matchPackageNames": ["react", "react-dom", "/^@types\\/react/"],
      "groupName": "react"
    },
    {
      "description": "Major updates: separate PRs, never automerged, labelled",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update"],
      "schedule": ["before 6am on the first day of the month"]
    },
    {
      "description": "Runtime/toolchain versions (Go, Node, pnpm) need a human look",
      "matchPackageNames": ["go", "golang", "nodejs", "node", "pnpm", "@types/node"],
      "automerge": false,
      "groupName": "toolchain versions"
    },
    {
      "description": "Dev-only type packages: low noise, automerge",
      "matchPackageNames": ["/^@types\\//"],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": null
  }
}
