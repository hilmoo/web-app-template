{
	"name": "web-app-template",
	"dockerComposeFile": "compose.yaml",
	"service": "workspace",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"remoteUser": "vscode",
	"remoteEnv": {
		// nix from the host's /nix mount (no-op with the named volume if the path doesn't exist)
		"PATH": "${containerEnv:PATH}:/nix/var/nix/profiles/default/bin"
	},
	"forwardPorts": [
		5432, // postgres
		8080, // core (serves the API under /api and the frontend)
		3000 // vite dev server (proxied by core)
	],
	"postCreateCommand": ".devcontainer/post-create.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				// Environment / tooling
				"jetpack-io.devbox",
				"mkhl.direnv",
				"task.vscode-task",
				"Anthropic.claude-code",
				// Go
				"golang.go",
				// TypeScript / JS
				"oxc.oxc-vscode",
				"TypeScriptTeam.native-preview",
				// API & schema (OpenAPI, TypeSpec, protobuf, YAML)
				"typespec.typespec-vscode",
				"42Crunch.vscode-openapi",
				"stoplight.spectral",
				"bufbuild.vscode-buf",
				"redhat.vscode-yaml",
				// Database
				"dbdiagram.dbdiagram-vscode"
			],
			"settings": {
				// -- Devbox / direnv --
				"json.schemaDownload.trustedDomains": {
					"https://raw.githubusercontent.com/jetify-com/devbox/": true,
					"https://raw.githubusercontent.com/oxc-project/oxc/": true
				},
				// -- Go --
				"go.lintTool": "golangci-lint-v2",
				"go.lintFlags": [
					"--path-mode=abs",
					"--fast-only"
				],
				"go.formatTool": "custom",
				"go.formatFlags": [
					"fmt",
					"--stdin"
				],
				"go.alternateTools": {
					"customFormatter": "${containerWorkspaceFolder}/.devbox/nix/profile/default/bin/golangci-lint",
					"golangci-lint-v2": "${containerWorkspaceFolder}/.devbox/nix/profile/default/bin/golangci-lint",
					"gopls": "${containerWorkspaceFolder}/.devbox/nix/profile/default/bin/gopls"
				},
				// -- TypeScript (tsgo) --
				"js/ts.experimental.useTsgo": true,
				"js/ts.tsdk.path": "${containerWorkspaceFolder}/.devbox/nix/profile/default/lib/typescript/lib",
				// -- Oxc (lint / format) --
				"oxc.path.node": "${containerWorkspaceFolder}/.devbox/nix/profile/default/bin/node",
				"oxc.path.oxfmt": "${containerWorkspaceFolder}/.devbox/nix/profile/default/bin/oxfmt",
				"oxc.path.oxlint": "${containerWorkspaceFolder}/.devbox/nix/profile/default/bin/oxlint",
				"oxc.path.tsgolint": "${containerWorkspaceFolder}/.devbox/nix/profile/default/bin/tsgolint",
				"editor.codeActionsOnSave": {
					"source.fixAll.oxc": "explicit"
				},
				// -- API tooling --
				"typespec.tsp-server.path": "${containerWorkspaceFolder}/openapi/node_modules/@typespec/compiler",
				"buf.commandLine.path": "${containerWorkspaceFolder}/.devbox/nix/profile/default/bin/buf",
				// -- Generated files (hide from watcher/search, make read-only) --
				"files.watcherExclude": {
					"**/routeTree.gen.ts": true
				},
				"search.exclude": {
					"**/routeTree.gen.ts": true
				},
				"files.readonlyInclude": {
					"**/routeTree.gen.ts": true
				}
			}
		}
	}
}