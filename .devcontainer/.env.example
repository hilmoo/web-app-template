# Copy to .devcontainer/.env to customise the devcontainer (optional).
# Without it, /nix is the shared named volume.

# Use the host's nix (daemon mode) instead of the named volume:
# NIX_MOUNT_SOURCE=/nix
# NIX_REMOTE=daemon

# Override the named volume's name (only used when NIX_MOUNT_SOURCE is unset):
# NIX_VOLUME_NAME=shared-nix-my-devcontainer-2026.10.16
