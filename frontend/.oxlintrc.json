{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/heads/main/npm/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "rules": {
    "array-callback-return": "error",
    "no-duplicate-imports": "error",
    "no-var": "error",
    "no-self-compare": "error",
    "no-template-curly-in-string": "error",
    "curly": "error",
    "default-case": "off",
    "default-case-last": "error",
    "no-alert": "error",
    "no-console": "error",
    "no-else-return": "error",
    "no-eval": "error",
    "no-lonely-if": "error",
    "no-multi-assign": "error",
    "no-multi-str": "error",
    "no-param-reassign": "error",
    "no-return-assign": "error",
    "no-script-url": "error",
    "no-sequences": "error",
    "no-throw-literal": "error",
    "no-unneeded-ternary": "error",
    "no-useless-call": "error",
    "no-useless-constructor": "error",
    "no-useless-return": "error",
    "operator-assignment": "error",
    "prefer-const": "error",
    "prefer-exponentiation-operator": "error",
    "prefer-object-has-own": "error",
    "prefer-promise-reject-errors": "error",
    "prefer-object-spread": "error",
    "prefer-template": "error",
    "yoda": "error",
    "radix": "error",
    "eqeqeq": ["error", "smart"],
    "no-undef": "off",
    "no-empty": "off",
    "no-unused-expressions": "off",
    "no-redeclare": "off",
    "no-use-before-define": "off",
    "no-loop-func": "off",
    "typescript/no-explicit-any": "off",
    "typescript/ban-ts-comment": "off",
    "typescript/consistent-generic-constructors": "error",
    "typescript/no-empty-object-type": "off",
    "typescript/no-namespace": "off",
    "typescript/no-unsafe-function-type": "off",
    "typescript/no-deprecated": "warn",
    "no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "caughtErrors": "none",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "react/button-has-type": "error",
    "react/jsx-boolean-value": "error",
    "react/jsx-curly-brace-presence": [
      "error",
      {
        "props": "never",
        "children": "never",
        "propElementValues": "ignore"
      }
    ],
    "react/jsx-fragments": ["error", "syntax"],
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-children-prop": "error",
    "react/no-find-dom-node": "error",
    "react/no-string-refs": "error",
    "react/self-closing-comp": "error",
    "react/void-dom-elements-no-children": "error",
    // React Compiler rules (oxlint 1.79+): they report compiler bail-outs rather than
    // actual defects, and misreport context objects that hold DOM nodes.
    // `preserve-manual-memoization` is `exhaustive-deps` under a new name, which is off on purpose.
    "react/refs": "off",
    "react/immutability": "off",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/globals": "off",
    "react/use-memo": "off",
    "react/preserve-manual-memoization": "off",
    "react/incompatible-library": "off",
    "react-hooks/exhaustive-deps": "off"
  },
  "overrides": [
    // Import boundaries (the frontend's depguard; see .agents/skills/frontend-pattern).
    // A later override replaces an earlier no-restricted-imports, so each block restates the shared patterns.
    {
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#/features/*/**"],
                "message": "Import another feature only through its index.ts (#/features/<feature>)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#/features/**"],
                "message": "shared/ must not depend on a feature; move the code into a feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["#/features/*/**"],
                "message": "Import another feature only through its index.ts (#/features/<feature>)."
              },
              {
                "group": ["../../**"],
                "message": "Do not leave the feature with relative imports; use #/features/<feature> or #/shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/components/**", "src/features/*/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@connectrpc/connect-query",
                "message": "Call RPCs through the feature's api/use-<feature>-<op>.ts hook."
              },
              {
                "name": "proto/servicesV1",
                "message": "Call RPCs through the feature's api/use-<feature>-<op>.ts hook; take message types from proto/modelsV1."
              }
            ],
            "patterns": [
              {
                "group": ["#/features/*/**"],
                "message": "Import another feature only through its index.ts (#/features/<feature>)."
              },
              {
                "group": ["../../**"],
                "message": "Do not leave the feature with relative imports; use #/features/<feature> or #/shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react-hook-form",
                "message": "api/ is data access only; forms live in components/."
              },
              {
                "name": "@tanstack/react-router",
                "message": "api/ is data access only; navigate from pages/ or guards.ts."
              }
            ],
            "patterns": [
              {
                "group": ["@mantine/**"],
                "message": "api/ is data access only; UI and notifications live in components/."
              },
              {
                "group": ["#/features/*/**"],
                "message": "Import another feature only through its index.ts (#/features/<feature>)."
              },
              {
                "group": ["../../**"],
                "message": "Do not leave the feature with relative imports; use #/features/<feature> or #/shared."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "react/jsx-key": "off",
        "no-unsafe-optional-chaining": "off"
      }
    }
  ]
}
