{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
  "packages": [
    // language runtimes
    "go@1.27.0",
    "nodejs@24.12.0",
    "pnpm@11.22.0",
    // go tools
    "gopls@0.23.0",
    "sqlc@1.31.1",
    "golangci-lint@2.14.0",
    // node tools
    "oxlint@1.86.0",
    "oxfmt@0.68.0",
    "tsgolint@7.0.2003",
    "typescript@7.0.2",
    "tsx@4.23.12",
    // protoc tools
    "protobuf@35.1",
    "protoc-gen-go@1.36.12",
    "protoc-go-inject-tag@1.4.0",
    "protoc-gen-connect-go@1.20.0",
    "protoc-gen-es@2.12.0",
    "buf@1.72.0",
    // other tools
    "pgformatter@5.10",
    "openapi-generator-cli@7.26.0",
    "watchexec@2.5.1",
    "zellij@0.45.1",
    "lefthook@2.1.15"
  ],
  "shell": {
    "init_hook": [
      "export DEVBOX_SEARCH_HOST=https://www.nixsearch.com",
      ". ./init-hook.sh"
    ]
  },
  "env": {
    "VACUUM": "openapi/.spectral.yaml"
  },
  "env_from": ".env"
}
