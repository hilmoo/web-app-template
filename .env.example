# Copy to .env (post-create does this automatically in the devcontainer).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/web-app-template
# Used to hash session tokens. Change it outside local development.
SECRET=supersecret
# Bearer token trusted internal services present (Authorization: Bearer ...).
SERVICE_SECRET=supersecret

# Optional
# LISTEN_ADDR=127.0.0.1:8080
# LOG_LEVEL=INFO
# APP_ENV=production
